# ============================================================
# APTRG LMS — Frontend Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to the repository.
# ============================================================

# Base URL of the Laravel backend (no trailing slash).
# Local default: php artisan serve -> http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# true = domains without a finished backend endpoint use in-memory mocks
# (src/services/mock). Auth always uses the real backend.
VITE_USE_MOCKS=true
