# ============================================================
# APTRG LMS — Frontend Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to the repository.
# ============================================================

# Base URL of the Laravel backend (no trailing slash).
# Local default: php artisan serve -> http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Comma-separated domains that still use in-memory mocks (src/services/mock)
# until their integration step. Options: users, divisions, materials,
# assignments, announcements, notifications. Empty = real API everywhere
# (required in production). Auth always uses the real backend.
VITE_MOCK_DOMAINS=assignments,announcements,notifications
